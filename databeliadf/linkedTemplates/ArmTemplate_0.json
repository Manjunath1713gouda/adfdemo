									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Get list of files').output.childItems",
								"type": "Expression"
							},
							"condition": {
								"value": "@startswith(item().name,'a')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Wait1",
