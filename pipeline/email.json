{
	"name": "email",
	"properties": {
		"activities": [
			{
				"name": "send_email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "logic_app_Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
