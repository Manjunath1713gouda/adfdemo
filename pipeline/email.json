			},
			"email_recepient": {
				"type": "string"
			}
		},
		"variables": {
			"logicapp_body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": [],
