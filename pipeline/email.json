					},
					"url": "https://prod-29.southindia.logic.azure.com:443/workflows/7fd13889a7524c71996bbd022049ee49/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=BFnQkWFOSdTFzzi7iegKhkL2wgEJJ0QeZXom6RkI4CY",
					"body": {
						"value": "@variables('logicapp_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "logic_app_Body",
				"type": "SetVariable",
