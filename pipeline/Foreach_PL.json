{
	"name": "Foreach_PL",
	"properties": {
		"activities": [
			{
				"name": "Ingested All tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Read List of Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read List of Tables').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Execute Ingestion Pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pipeline2",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_name": {
										"value": "@item().table_name",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Store Table Success",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Execute Ingestion Pipeline",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_status",
								"value": {
									"value": "@{item().table_name} - Success",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Store Table Failure",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Execute Ingestion Pipeline",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_status",
								"value": {
									"value": "@{item().table_name} - Failure",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Read List of Tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT table_name from metadata.table_list",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_sql_db",
						"type": "DatasetReference",
						"parameters": {
							"schema": "dbo",
							"table_name": "customer"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Send Consolidated Email",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Ingested All tables",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "email_copy_multiple",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"email_recepient": {
							"value": "@pipeline().globalParameters.email_recepient",
							"type": "Expression"
						},
						"table_status": {
							"value": "@variables('table_status')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Fail1",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Ingested All tables",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": "This pipeline is failed due to previous activity",
					"errorCode": "500"
				}
			}
		],
		"variables": {
			"table_status": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-04T14:24:17Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}